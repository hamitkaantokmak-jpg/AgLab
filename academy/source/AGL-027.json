  "steps": [
    {
      "order": 1,
      "text": "VLAN 10 için 192.168.10.0/24, VLAN 20 için 192.168.20.0/24 planını incele."
    },
    {
      "order": 2,
      "text": "Aynı VLAN çiftlerini ping ile doğrula."
    },
    {
      "order": 3,
      "text": "PC1 → PC2 erişiminin router yokken başarısız olduğunu doğrula."
    },
    {
      "order": 4,
      "text": "VLAN’lar arası erişimde gerekli işlevi seç."
    }
  ],
