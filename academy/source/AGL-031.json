  "steps": [
    {
      "order": 1,
      "text": "R1 g0/0=192.168.10.1/24 ve g0/1=192.168.20.1/24 yapılandır; portları aç."
    },
    {
      "order": 2,
      "text": "PC gateway alanlarını plana göre kontrol et."
    },
    {
      "order": 3,
      "text": "CLI varsa show ip interface brief ve show ip route incele."
    },
    {
      "order": 4,
      "text": "İki yönde ping dene; ek statik rota gerekip gerekmediğini cevapla."
    }
  ],
