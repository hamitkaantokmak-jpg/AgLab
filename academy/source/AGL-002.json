    {
      "order": 1,
      "text": "PC2’ye 192.168.1.20 ve 255.255.255.0 gir."
    },
    {
      "order": 2,
      "text": "Her iki gateway alanını boş bırak."
    },
    {
      "order": 3,
      "text": "PC1 → PC2 ping dene."
    },
    {
      "order": 4,
      "text": "Uç cihaz, Katman 2 iletim cihazı ve ağlar arası iletim cihazını seçeneklerden eşleştir."
    }
  ],
