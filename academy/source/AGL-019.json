  "steps": [
    {
      "order": 1,
      "text": "192.168.19.0/24 havuzunda A=50, B=20 ve transit=2 adres ihtiyacını en küçük uygun bloklarla sırayla yerleştir."
    },
    {
      "order": 2,
      "text": "A için .0/26 ayır; B ve transiti bitişik ve çakışmasız seç."
    },
    {
      "order": 3,
      "text": "PC1=192.168.19.1/26, PC2=192.168.19.62/26 yapılandır; gateway boş kalsın."
    },
    {
      "order": 4,
      "text": "Yerel ping gönder ve cevap alanlarını doldur."
    }
  ],
