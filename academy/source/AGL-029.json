  "steps": [
    {
      "order": 1,
      "text": "Mevcut access uçlarının ait olduğu farklı VLAN sayısını hesapla; uçsuz VLAN 1’i bu sayıya katma."
    },
    {
      "order": 2,
      "text": "İki trunk ucunda nativeVlan=1 olduğunu doğrula."
    },
    {
      "order": 3,
      "text": "Native VLAN’ın yaygın etiket davranışını seç."
    },
    {
      "order": 4,
      "text": "PC1 → PC3 erişimini kontrol et."
    }
  ],
  "expected_result": "Aktif uç grupları iki yayın alanındadır; native ayarlar eşleşir.",
