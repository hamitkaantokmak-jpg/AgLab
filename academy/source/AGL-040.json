    "explanation": "PC2 gateway=.20.1; R3 g0/1 no shutdown; R2 192.168.20.0/24 → 10.0.23.2. Diğer rotalar korunur.",
    "answer_key": {},
    "target_topology_file": "../topologies/AGL-040-solution.aglab.json",
    "reference_commands": {
      "SW1": [
        "enable",
        "configure terminal",
        "interface fa0/1",
        "switchport mode access",
        "switchport access vlan 1",
        "no shutdown",
        "exit",
        "interface gi0/1",
        "switchport mode access",
        "switchport access vlan 1",
        "no shutdown",
        "exit",
        "end"
      ],
      "R1": [
        "enable",
        "configure terminal",
        "interface g0/0",
        "ip address 192.168.10.1 255.255.255.0",
        "no shutdown",
        "exit",
        "interface g0/1",
        "ip address 10.0.12.1 255.255.255.252",
        "no shutdown",
        "exit",
        "ip route 192.168.20.0 255.255.255.0 10.0.12.2",
        "end"
      ],
      "R2": [
        "enable",
        "configure terminal",
        "interface g0/1",
        "ip address 10.0.12.2 255.255.255.252",
        "no shutdown",
        "exit",
        "interface g0/2",
        "ip address 10.0.23.1 255.255.255.252",
        "no shutdown",
        "exit",
        "ip route 192.168.10.0 255.255.255.0 10.0.12.1",
