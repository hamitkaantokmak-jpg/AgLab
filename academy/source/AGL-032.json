  "steps": [
    {
      "order": 1,
      "text": "PC1 gateway=192.168.10.1, PC2 gateway=192.168.20.1 yap."
    },
    {
      "order": 2,
      "text": "Önce her PC’den kendi router arayüzüne ping gönder."
    },
    {
      "order": 3,
      "text": "PC1 → PC2 ve ters yönde ping dene."
    },
    {
      "order": 4,
      "text": "Gateway’in uç ile aynı alt ağda olması gerekip gerekmediğini cevapla."
    }
  ],
