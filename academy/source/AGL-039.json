    "PC’den PC’ye erişim için uzak transit ağlara ayrıca rota şart değildir; router kaynaklı testte kaynak IP farklı olabilir."
  ],
  "teacher_solution": {
    "explanation": "Dört statik rota hedef topolojideki gibi eklenir. R2 iki uç ağı bilir; R1/R3 karşı uç ağını bilir.",
    "answer_key": {},
    "target_topology_file": "../topologies/AGL-039-solution.aglab.json",
    "reference_commands": {
      "SW1": [
        "enable",
        "configure terminal",
        "interface fa0/1",
        "switchport mode access",
        "switchport access vlan 1",
        "no shutdown",
        "exit",
        "interface gi0/1",
        "switchport mode access",
        "switchport access vlan 1",
        "no shutdown",
        "exit",
        "end"
      ],
      "R1": [
        "enable",
        "configure terminal",
        "interface g0/0",
        "ip address 192.168.10.1 255.255.255.0",
        "no shutdown",
        "exit",
        "interface g0/1",
        "ip address 10.0.12.1 255.255.255.252",
        "no shutdown",
        "exit",
        "ip route 192.168.20.0 255.255.255.0 10.0.12.2",
        "end"
      ],
      "R2": [
        "enable",
        "configure terminal",
        "interface g0/1",
        "ip address 10.0.12.2 255.255.255.252",
        "no shutdown",
        "exit",
        "interface g0/2",
        "ip address 10.0.23.1 255.255.255.252",
        "no shutdown",
        "exit",
        "ip route 192.168.10.0 255.255.255.0 10.0.12.1",
        "ip route 192.168.20.0 255.255.255.0 10.0.23.2",
        "end"
      ],
      "R3": [
        "enable",
        "configure terminal",
        "interface g0/0",
        "ip address 192.168.20.1 255.255.255.0",
        "no shutdown",
        "exit",
        "interface g0/1",
        "ip address 10.0.23.2 255.255.255.252",
        "no shutdown",
        "exit",
        "ip route 192.168.10.0 255.255.255.0 10.0.23.1",
