          "ip": "10.0.12.1",
          "mask": "255.255.255.252"
        },
        "label": "R1 transit",
        "points": 20,
        "id": "AGL-033-C01",
        "required_capabilities": [
          "state_adapter"
        ],
        "on_unavailable": "not_evaluated"
      },
      {
