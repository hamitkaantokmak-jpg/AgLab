  "steps": [
    {
      "order": 1,
      "text": "R1 g0/1=10.0.12.1/30 ve R2 g0/1=10.0.12.2/30 yapılandır; aç."
    },
    {
      "order": 2,
      "text": "R1’den 10.0.12.2’ye ping gönder; kaynak arayüzü g0/1 olarak seçebilen bağdaştırıcı kullan."
    },
    {
      "order": 3,
      "text": "Rotaları ekleme; PC1 → PC2 erişiminin henüz olmadığını doğrula."
    },
    {
      "order": 4,
      "text": "Transit ağ ve yayın adreslerini cevapla."
    }
  ],
  "expected_result": "Router komşuları erişir; uzak LAN uçları henüz erişemez.",
  "assessment": {
    "max_points": 100,
    "criteria": [
      {
        "kind": "state.equals",
        "target": "devices.R1.interfaces.g0/1",
        "expected": {
