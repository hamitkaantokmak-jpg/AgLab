  "steps": [
    {
      "order": 1,
      "text": "R1 üzerinde 192.168.20.0/24 ve 0.0.0.0/0 rotalarını incele."
    },
    {
      "order": 2,
      "text": "192.168.20.20 hedefi için seçilecek öneği cevapla."
    },
    {
      "order": 3,
      "text": "203.0.113.9 hedefi için R1’de eşleşen öneği cevapla; bu hedefe erişim bekleme."
    },
    {
      "order": 4,
      "text": "Karşı LAN ping’i ile mevcut erişimi doğrula."
    }
  ],
  "expected_result": "Özel hedef için /24, diğer örnek hedef için /0 seçilir.",
