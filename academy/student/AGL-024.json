  "steps": [
    {
      "order": 1,
      "text": "SW1 ve SW2 gi0/1 arayüzlerini trunk yap."
    },
    {
      "order": 2,
      "text": "İki uçta allowed VLAN listesini 10,20 ayarla; native VLAN 1 olarak aynı kalsın."
    },
    {
      "order": 3,
      "text": "VLAN 10/20 veritabanlarını kontrol et."
    },
    {
      "order": 4,
      "text": "PC1 → PC3 ve PC2 → PC4 ping dene."
    }
  ],
  "expected_result": "Aynı VLAN’daki karşı switch uçları erişir.",
