    {
      "order": 1,
      "text": "R1 rotasındaki 10.0.12.3 değerinin /30 broadcast olduğunu hesapla."
    },
    {
      "order": 2,
      "text": "Yanlış rotayı kaldır; R1 rotasını next-hop 10.0.12.2 ile yeniden ekle."
    },
    {
      "order": 3,
      "text": "R2 dönüş rotasını koru."
    },
    {
      "order": 4,
      "text": "İki yönde ping gönder."
    }
  ],
