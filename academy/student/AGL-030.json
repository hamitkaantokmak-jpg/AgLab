  "steps": [
    {
      "order": 1,
      "text": "SW2 fa0/2’yi VLAN 20 yap."
    },
    {
      "order": 2,
      "text": "SW1 gi0/1 allowed listesini 10,20 yap."
    },
    {
      "order": 3,
      "text": "PC1 → PC3 ve PC2 → PC4 erişimini doğrula."
    },
    {
      "order": 4,
      "text": "PC1 → PC2 erişiminin olmamasını doğrula."
    }
  ],
  "expected_result": "İki bölüm kendi içinde erişir; bölümler birbirinden yalıtılır.",
