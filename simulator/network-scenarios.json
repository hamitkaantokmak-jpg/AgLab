              "enabled": true,
              "parent": "g0/0",
              "vlan": 10,
              "encapsulation": "dot1q"
            }
          },
          "staticRoutes": []
        },
        {
          "id": "d4",
          "name": "PC-02",
          "type": "PC",
          "x": 670,
          "y": 100,
          "w": 104,
          "h": 72,
          "enabled": true,
          "ip": "192.168.20.20",
          "mask": "255.255.255.0",
          "gateway": "192.168.20.1",
          "vlan": 20,
          "ports": [
            "eth0"
          ],
          "interfaces": {
            "eth0": {
              "enabled": true
            }
          }
        }
      ],
      "links": [
        {
          "a": "d1",
          "b": "d2",
          "portA": "eth0",
          "portB": "fa0/1",
          "up": true
        },
        {
          "a": "d4",
          "b": "d2",
          "portA": "eth0",
          "portB": "fa0/2",
          "up": true
        },
        {
          "a": "d2",
          "b": "d3",
          "portA": "gi0/1",
          "portB": "g0/0",
          "up": true
        }
      ],
      "nextId": 20
    },
    "solution": [
      {
        "device": "R1",
        "commands": [
          "enable",
          "configure terminal",
          "interface g0/0.20",
          "encapsulation dot1q 20",
          "ip address 192.168.20.1 255.255.255.0",
          "no shutdown",
          "end"
        ]
      }
    ],
    "verify": {
      "kind": "ping"
    }
  },
