            }
          }
        },
        {
          "id": "d3",
          "name": "R1",
          "type": "Router",
          "x": 400,
          "y": 330,
          "w": 108,
          "h": 72,
          "enabled": true,
          "ports": [
            "g0/0",
            "g0/1"
          ],
          "interfaces": {
            "g0/0": {
              "ip": "",
              "mask": "255.255.255.0",
              "enabled": true
            },
            "g0/1": {
              "ip": "",
